{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types", "vitest/globals"],
    "lib": ["ES2022", "WebWorker"],
    "noEmit": true
  },
  "include": ["domains/**/*.ts", "tests/engine/**/*.ts"]
}
